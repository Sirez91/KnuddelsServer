# Dependencies
node_modules/

# Build output
dist/
*.tsbuildinfo

# Test sandbox
.test-env/

# apps/ is tracked as an empty drop-folder; never commit its contents
apps/*
!apps/.gitkeep

# Environment / secrets
.env
.env.*
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Coverage
coverage/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*~

# Claude per-process state (settings.local.json is excluded globally)
.claude/scheduled_tasks.lock
